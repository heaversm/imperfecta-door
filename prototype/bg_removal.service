[Unit]
Description=Imperfecta Background Removal Server
After=network-online.target
Wants=network-online.target

[Service]
User=imperfecta
WorkingDirectory=/home/imperfecta
EnvironmentFile=/home/imperfecta/.env
ExecStart=/usr/bin/python3 /home/imperfecta/bg_removal_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
